# Copia este archivo como .env.local para cambiar la configuración en tu máquina (no se versiona).

# URL de la API. Si no se define:
#   - con `npm run dev`, el front llama a /api del mismo origen y el proxy de Vite lo lleva a producción;
#   - en la compilación, se usa la API de producción en Azure.
# Ejemplo, con el back corriendo en local (debe aceptar http://localhost:5173 en CORS_ORIGENES):
# VITE_API_URL=http://localhost:8080
